{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "PARTIES", "class_name": "Party" }],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    // Parties replace per-game rooms. Deleting Room drops every old room and its storage.
    { "tag": "v2", "new_sqlite_classes": ["Party"], "deleted_classes": ["Room"] },
  ],
  "observability": { "enabled": true },
}
